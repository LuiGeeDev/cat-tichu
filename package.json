{
  "name": "cat-tichu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "고양이 테마 4인 티츄 (Cat Tichu) — online multiplayer Tichu",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
